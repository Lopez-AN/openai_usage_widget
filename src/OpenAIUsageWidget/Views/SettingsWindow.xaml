<Window x:Class="OpenAIUsageWidget.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración · OpenAI Usage" Width="530" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24">
        <TextBlock Text="Configuración" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="CUENTAS" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,20,0,9" />
        <ListBox x:Name="AccountList" ItemsSource="{Binding Accounts}" Height="120" Background="#1A1E24" Foreground="White" BorderBrush="#353C46" SelectionChanged="AccountList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate><StackPanel Margin="5"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Email}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" /></StackPanel></DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Margin="0,9,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="AliasText" MaxLength="60" AutomationProperties.Name="Cambiar nombre de la cuenta" />
            <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="Renombrar" Click="Rename_Click" Margin="8,0,0,0" />
        </Grid>
        <WrapPanel>
            <Button Style="{StaticResource FlatButton}" Content="Agregar cuenta" Click="Add_Click" Margin="0,0,7,0" />
            <Button Style="{StaticResource FlatButton}" Content="Reconectar" Click="Reconnect_Click" Margin="0,0,7,0" />
            <Button Style="{StaticResource FlatButton}" Content="Quitar cuenta" Click="Remove_Click" />
        </WrapPanel>
        <TextBlock Text="CONECTOR DE CUOTAS" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,22,0,8" />
        <TextBlock Text="Ruta a Codex CLI (vacía = detectar automáticamente)" FontSize="12" Margin="0,0,0,7" />
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="ExecutableText" AutomationProperties.Name="Ruta al ejecutable de Codex" />
            <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="Buscar…" Click="Browse_Click" Margin="8,0,0,0" />
        </Grid>
        <TextBlock Text="Se usa únicamente para iniciar sesión y consultar cuotas. Los perfiles de este widget están separados de tus sesiones de OpenCode y Codex." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18" />
        <CheckBox x:Name="AutostartCheck" Content="Iniciar el widget al entrar en Windows" />
        <TextBlock Text="Actualización automática cada 5 minutos. El equipo debe estar encendido; al reanudar se consultan los datos vencidos." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
        <TextBlock x:Name="StatusText" Foreground="#E6BC76" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
        <Grid Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Style="{StaticResource FlatButton}" Content="Abrir datos locales" Click="OpenData_Click" HorizontalAlignment="Left" />
            <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="Guardar" Background="#086C52" Click="Save_Click" Padding="22,9" />
        </Grid>
    </StackPanel>
</Window>
