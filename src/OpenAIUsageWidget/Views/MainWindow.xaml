<Window x:Class="OpenAIUsageWidget.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenAI Usage Widget" Width="440" SizeToContent="Height" MinHeight="300"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="False"
        AutomationProperties.Name="Widget de cuota de OpenAI, solo lectura">
    <Border x:Name="WidgetSurface" CornerRadius="15" BorderThickness="1" BorderBrush="#45494F" Background="{StaticResource WindowBrush}"
            Padding="13,12,13,10" MouseLeftButtonDown="DragSurface_MouseLeftButtonDown">
        <StackPanel>
            <Grid Margin="2,0,1,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ToggleButton x:Name="AccountToggle" Background="Transparent" BorderThickness="0" Cursor="Hand"
                              HorizontalContentAlignment="Stretch" Visibility="{Binding HasAccounts, Converter={StaticResource BoolVisibility}}"
                              AutomationProperties.Name="Cambiar cuenta" ToolTip="Cambiar cuenta">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Hover" CornerRadius="9" Background="Transparent" Padding="0,2,5,2">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Background" Value="#1D2228" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Hover" Property="BorderBrush" Value="#688BFF" /><Setter TargetName="Hover" Property="BorderThickness" Value="1" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="45" /><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions>
                        <Border Width="39" Height="39" CornerRadius="20" Background="{Binding SelectedAccount.AvatarColor}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding SelectedAccount.Initials}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,4,0">
                            <TextBlock Text="{Binding SelectedAccount.DisplayName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedAccount.Email}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="7" Height="7" Fill="{Binding SelectedAccount.PlanColor}" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding SelectedAccount.PlanLabel}" FontSize="10.5" Foreground="#D7DBE2" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                </ToggleButton>
                <StackPanel VerticalAlignment="Center" Visibility="{Binding HasNoAccounts, Converter={StaticResource BoolVisibility}}" Margin="2,0,0,0">
                    <TextBlock Text="OpenAI Usage" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Tu cuota, de un vistazo" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}"
                        Margin="8,0,7,0" ToolTip="Refrescar cuenta · actualización automática cada 5 min" AutomationProperties.Name="Refrescar cuota">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="18" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Command="{Binding SettingsCommand}"
                        ToolTip="Configuración y cuentas" AutomationProperties.Name="Configuración y cuentas">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" />
                </Button>
            </Grid>

            <Popup x:Name="AccountsPopup" PlacementTarget="{Binding ElementName=AccountToggle}" Placement="Bottom" VerticalOffset="7"
                   IsOpen="{Binding IsChecked, ElementName=AccountToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="#14181D" BorderBrush="#3E454F" BorderThickness="1" CornerRadius="12" Padding="7" Width="280">
                    <StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="290" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Accounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource FlatButton}" Background="Transparent" Padding="7,9" HorizontalContentAlignment="Stretch"
                                                Click="AccountItem_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="39" /><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions>
                                                <Border Background="{Binding AvatarColor}" CornerRadius="17" Width="33" Height="33" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Initials}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,5,0">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Ellipse Width="6" Height="6" Fill="{Binding PlanColor}" Margin="0,0,5,0" />
                                                        <TextBlock Text="{Binding PlanLabel}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#xE73E;" Foreground="#6E8EFF" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"
                                                           Visibility="{Binding IsSelected, Converter={StaticResource BoolVisibility}}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border Height="1" Background="#2B3038" Margin="5,4,5,7" />
                        <Button Style="{StaticResource FlatButton}" Command="{Binding AddAccountCommand}" HorizontalContentAlignment="Left" Click="AccountItem_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,1,12,0" /><TextBlock Text="Agregar nueva cuenta" FontSize="12" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <StackPanel Visibility="{Binding HasAccounts, Converter={StaticResource BoolVisibility}}">
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="10,12" Margin="0,0,0,9" ToolTip="{Binding SelectedAccount.FiveHourDetail}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="43" Height="47" Background="#15372E" CornerRadius="10" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="27" Foreground="#00E6A0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Límite de 5 horas" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedAccount.FiveHourPercent}" FontSize="16" FontWeight="SemiBold" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,5,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SelectedAccount.FiveHourReset}" FontSize="10.5" Foreground="#D0D4DC" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="restante" FontSize="10.5" Margin="8,0,0,0" Foreground="#D0D4DC" />
                            </Grid>
                            <ProgressBar Grid.Row="2" Style="{StaticResource QuotaBar}" Value="{Binding SelectedAccount.FiveHourRemaining, Mode=OneWay}" Foreground="{StaticResource FiveHourBrush}" AutomationProperties.Name="Cuota restante de 5 horas" />
                        </Grid>
                    </Grid>
                </Border>
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="10,12" Margin="0,0,0,11" ToolTip="{Binding SelectedAccount.WeeklyDetail}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="43" Height="47" Background="#222B43" CornerRadius="10" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="27" Foreground="#518DFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Límite semanal" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedAccount.WeeklyPercent}" FontSize="16" FontWeight="SemiBold" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,5,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SelectedAccount.WeeklyReset}" FontSize="10.5" Foreground="#D0D4DC" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="restante" FontSize="10.5" Margin="8,0,0,0" Foreground="#D0D4DC" />
                            </Grid>
                            <ProgressBar Grid.Row="2" Style="{StaticResource QuotaBar}" Value="{Binding SelectedAccount.WeeklyRemaining, Mode=OneWay}" Foreground="{StaticResource WeeklyBrush}" AutomationProperties.Name="Cuota semanal restante" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Height="1" Background="#34383E" />
                <Grid Margin="9,11,4,1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="29" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="29" /><ColumnDefinition Width="114" /></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" Foreground="#D7DCE3" />
                    <StackPanel Grid.Column="1"><TextBlock Text="Última actualización" FontSize="10" Foreground="#C4C9D3" /><TextBlock Text="{Binding SelectedAccount.LastUpdate}" FontSize="10.5" Margin="0,4,0,0" /></StackPanel>
                    <Border Grid.Column="2" Background="#30343A" Margin="0,1" />
                    <TextBlock Grid.Column="3" Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="20" Margin="9,0,0,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="4" Margin="11,0,0,0" ToolTip="{Binding SelectedAccount.ResetsDetail}">
                        <TextBlock Text="Reseteos disponibles" FontSize="10" Foreground="#C4C9D3" /><TextBlock Text="{Binding SelectedAccount.AvailableResets}" FontSize="15" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Actualizando…" Foreground="#9FB6FF" FontSize="10" Margin="10,6,0,0" Visibility="{Binding SelectedAccount.IsRefreshing, Converter={StaticResource BoolVisibility}}" />
                <TextBlock Text="{Binding SelectedAccount.WarningText}" ToolTip="{Binding SelectedAccount.Error}" Foreground="#E6BC76" FontSize="10" Margin="10,6,0,0"
                           Visibility="{Binding SelectedAccount.HasWarning, Converter={StaticResource BoolVisibility}}" />
            </StackPanel>

            <StackPanel Visibility="{Binding HasNoAccounts, Converter={StaticResource BoolVisibility}}" Margin="10,20,10,28">
                <TextBlock Text="Tu primera cuenta, acá" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Conectá una cuenta de ChatGPT para ver tus&#x0a;límites de Codex y los reseteos disponibles." TextAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,20" />
                <Button Command="{Binding AddAccountCommand}" Style="{StaticResource FlatButton}" Background="#086C52" HorizontalAlignment="Center" Padding="18,11" AutomationProperties.Name="Agregar primera cuenta">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,2,9,0" /><TextBlock Text="Agregar primera cuenta" FontWeight="SemiBold" /></StackPanel>
                </Button>
                <TextBlock Text="Solo lectura · sin consumir cuota" Foreground="#8F99A8" FontSize="10" HorizontalAlignment="Center" Margin="0,14,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding StorageError}" Foreground="#E6BC76" FontSize="10" TextWrapping="Wrap" Margin="8,5,0,0" Visibility="{Binding HasStorageError, Converter={StaticResource BoolVisibility}}" />
            <TextBlock Text="VISTA DE DEMOSTRACIÓN · datos ficticios · sin conexión" Foreground="#E6BC76" FontSize="10" HorizontalAlignment="Center" Margin="0,7,0,0" Visibility="{Binding IsDemo, Converter={StaticResource BoolVisibility}}" />
        </StackPanel>
    </Border>
</Window>
