<Application x:Class="OpenAIUsageWidget.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <SolidColorBrush x:Key="WindowBrush" Color="#111417" />
        <SolidColorBrush x:Key="CardBrush" Color="#191C20" />
        <SolidColorBrush x:Key="TextBrush" Color="#F5F6F8" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A9AFBA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#00E6A0" />
        <LinearGradientBrush x:Key="WeeklyBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2EA4FA" Offset="0" />
            <GradientStop Color="#783AF6" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FiveHourBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00D99B" Offset="0" />
            <GradientStop Color="#00F0AE" Offset="1" />
        </LinearGradientBrush>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#20242A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#30363E" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#3A424C" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#688BFF" /><Setter TargetName="Surface" Property="BorderThickness" Value="1" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" /><Setter Property="FontSize" Value="18" />
        </Style>
        <Style x:Key="QuotaBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="11" /><Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="#2A2D33" CornerRadius="6" />
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="6" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#20242A" /><Setter Property="Foreground" Value="#F5F6F8" />
            <Setter Property="CaretBrush" Value="White" /><Setter Property="BorderBrush" Value="#454C58" />
            <Setter Property="Padding" Value="9,7" /><Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></Style>
    </Application.Resources>
</Application>
